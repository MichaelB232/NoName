# ─────────────────────────────────────────────────────────────
# ROOT .env — consumed ONLY by docker-compose.yml (local infrastructure).
# Copy to `.env` and fill every empty value. `.env` is git-ignored.
# docker-compose will REFUSE to start if a required value is empty.
# ─────────────────────────────────────────────────────────────

# PostgreSQL 16
POSTGRES_USER=compliance
POSTGRES_PASSWORD=
POSTGRES_DB=compliance_agent
POSTGRES_PORT=5432

# Redis 7 (SSE pub/sub channel, rate limiting, cache)
REDIS_PASSWORD=
REDIS_PORT=6379

# MinIO (S3-compatible object storage for contract PDFs)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Qdrant (vector DB for regulation corpus)
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
