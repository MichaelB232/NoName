# ─────────────────────────────────────────────────────────────
# FRONTEND — copy to `frontend/.env.local`. NEVER commit it.
#
# ⚠️  Any variable prefixed NEXT_PUBLIC_ is bundled into browser JavaScript
#     and is PUBLIC. NEVER put API keys, tokens, or secrets in NEXT_PUBLIC_*.
#     The frontend holds NO credentials: auth is an httpOnly cookie set by the backend.
# ─────────────────────────────────────────────────────────────

# Public: base URL the browser uses to reach the backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Server-only: URL Server Components use to reach the backend (e.g. internal Docker DNS)
BACKEND_INTERNAL_URL=http://localhost:4000/api/v1
