# ─────────────────────────────────────────────────────────────
# BACKEND (API Gateway) — copy to `backend/.env`. NEVER commit `.env`.
# Every variable is validated at boot by src/config/env.ts (Zod).
# The process exits immediately if a required value is missing/invalid.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Comma-separated list of allowed browser origins (CORS + cookies)
CORS_ORIGINS=http://localhost:3000

# ─── PostgreSQL ───
# Format: postgres://USER:PASSWORD@HOST:PORT/DB  (must match root .env)
DATABASE_URL=

# ─── Redis (SSE progress channel + rate limiter) ───
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=

# ─── Auth (JWT in httpOnly cookie) ───
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=ca_session

# ─── Object storage (MinIO locally, AWS S3 in production) ───
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-3
S3_BUCKET=compliance-contracts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO requires path-style URLs; set false for AWS S3
S3_FORCE_PATH_STYLE=true
# Presigned URL TTL in seconds (multitenancy-security skill: max 600)
S3_PRESIGN_TTL_SECONDS=600
# Max upload size in bytes (25 MB)
UPLOAD_MAX_BYTES=26214400

# ─── Agent service (internal, service-to-service) ───
AGENT_SERVICE_URL=http://localhost:8000
# Shared secret; MUST equal AGENT_SERVICE_TOKEN in agent/.env
AGENT_SERVICE_TOKEN=
