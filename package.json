{
  "name": "compliance-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo workspace for Compliance-Agent: Autonomous FinTech Contract Compliance Copilot",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev:backend": "pnpm --filter @compliance-agent/backend dev",
    "dev:frontend": "pnpm --filter @compliance-agent/frontend dev",
    "dev:agent": "cd agent && uvicorn app.main:app --reload --port 8000",
    "test:backend": "pnpm --filter @compliance-agent/backend test",
    "test:agent": "cd agent && pytest",
    "typecheck": "pnpm --recursive run typecheck",
    "db:migrate": "pnpm --filter @compliance-agent/backend db:migrate",
    "db:generate": "pnpm --filter @compliance-agent/backend db:generate"
  }
}
