# ─────────────────────────────────────────────────────────────
# AGENT SERVICE — copy to `agent/.env`. NEVER commit `.env`.
# Validated at boot by app/core/config.py (pydantic-settings).
# ─────────────────────────────────────────────────────────────

APP_ENV=development
LOG_LEVEL=DEBUG
HOST=0.0.0.0
PORT=8000

# ─── Service-to-service auth ───
# Shared secret; MUST equal AGENT_SERVICE_TOKEN in backend/.env (min 32 chars)
AGENT_SERVICE_TOKEN=

# ─── Google Gemini (two-tier routing, .agents/SPEC.md §3) ───
GEMINI_API_KEY=
# Tier 1: extraction, JSON formatting, tool calling
GEMINI_MODEL_TIER1=gemini-2.0-flash
# Tier 2: legal reasoning, compliance evaluation, redrafting
GEMINI_MODEL_TIER2=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ─── Qdrant (regulation corpus) ───
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=indonesia_financial_regulations
# Retrieval below this cosine score is discarded → UNVERIFIED_CITATION
QDRANT_SCORE_THRESHOLD=0.72

# ─── Redis (publish agent progress for backend SSE relay) ───
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=

# ─── Langfuse (LLMOps tracing) ───
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Guardrails (.agents/AGENTS.md §1.3) ───
AGENT_MAX_STEPS=5
